+using Microsoft.EntityFrameworkCore; using RoomBooking.Web.Contracts; using RoomBooking.Web.Data; using RoomBooking.Web.Models;
+namespace RoomBooking.Web.Services;
+public sealed class BookingService(IDbContextFactory<RoomBookingDbContext> factory){
+ public async Task<List<RoomResponse>> GetRoomsAsync(bool activeOnly=false){await using var db=await factory.CreateDbContextAsync();var q=db.Rooms.AsNoTracking().AsQueryable();if(activeOnly)q=q.Where(x=>x.IsActive);return await q.OrderBy(x=>x.Name).Select(x=>new RoomResponse(x.Id,x.Name,x.Capacity,x.IsActive)).ToListAsync();}
+ public async Task<List<BookingResponse>> GetBookingsAsync(int? roomId=null,DateOnly? date=null,BookingStatus? status=null){await using var db=await factory.CreateDbContextAsync();var q=db.Bookings.AsNoTracking().Include(x=>x.Room).AsQueryable();if(roomId.HasValue)q=q.Where(x=>x.RoomId==roomId);if(date.HasValue){var s=new DateTimeOffset(date.Value.ToDateTime(TimeOnly.MinValue),TimeSpan.Zero);q=q.Where(x=>x.StartTime<s.AddDays(1)&&x.EndTime>s);}if(status.HasValue)q=q.Where(x=>x.Status==status);return await q.OrderBy(x=>x.StartTime).Select(ToResponse).ToListAsync();}
+ public async Task<BookingResponse?> GetAsync(int id){await using var db=await factory.CreateDbContextAsync();return await db.Bookings.AsNoTracking().Include(x=>x.Room).Where(x=>x.Id==id).Select(ToResponse).SingleOrDefaultAsync();}
+ public Task<(BookingResponse? Value,string? Error,int Code)> CreateAsync(BookingRequest r)=>SaveAsync(null,r); public Task<(BookingResponse? Value,string? Error,int Code)> UpdateAsync(int id,BookingRequest r)=>SaveAsync(id,r);
+ private async Task<(BookingResponse?,string?,int)> SaveAsync(int? id,BookingRequest r){if(string.IsNullOrWhiteSpace(r.Title)||string.IsNullOrWhiteSpace(r.BookedBy)||r.RoomId<=0)return(null,"Rubrik, bokare och rum krävs.",400);if(r.EndTime<=r.StartTime)return(null,"Sluttiden måste vara senare än starttiden.",400);if(r.StartTime<DateTimeOffset.UtcNow.AddMinutes(-1))return(null,"Bokningen får inte börja bakåt i tiden.",400);await using var db=await factory.CreateDbContextAsync();var room=await db.Rooms.SingleOrDefaultAsync(x=>x.Id==r.RoomId);if(room is null)return(null,"Mötesrummet finns inte.",404);if(!room.IsActive)return(null,"Mötesrummet är inaktivt.",409);var b=id.HasValue?await db.Bookings.SingleOrDefaultAsync(x=>x.Id==id):null;if(id.HasValue&&(b is null||b.Status==BookingStatus.Cancelled))return(null,"Bokningen kan inte redigeras.",409);if(await db.Bookings.AnyAsync(x=>x.RoomId==r.RoomId&&x.Status==BookingStatus.Active&&x.Id!=(id??0)&&r.StartTime<x.EndTime&&r.EndTime>x.StartTime))return(null,"Tiden kolliderar med en annan bokning.",409);b??=new Booking{CreatedAt=DateTimeOffset.UtcNow};b.Title=r.Title.Trim();b.BookedBy=r.BookedBy.Trim();b.RoomId=r.RoomId;b.StartTime=r.StartTime;b.EndTime=r.EndTime;b.Status=BookingStatus.Active;if(!id.HasValue)db.Bookings.Add(b);try{await db.SaveChangesAsync();}catch(DbUpdateException){return(null,"Bokningen kunde inte sparas på grund av en samtidig ändring.",409);}await db.Entry(b).Reference(x=>x.Room).LoadAsync();return(ToResponse.Compile()(b),null,200);}
+ public async Task<bool> CancelAsync(int id){await using var db=await factory.CreateDbContextAsync();var b=await db.Bookings.SingleOrDefaultAsync(x=>x.Id==id);if(b is null)return false;if(b.Status!=BookingStatus.Cancelled){b.Status=BookingStatus.Cancelled;await db.SaveChangesAsync();}return true;} public static System.Linq.Expressions.Expression<Func<Booking,BookingResponse>> ToResponse=>x=>new BookingResponse(x.Id,x.Title,x.BookedBy,x.RoomId,x.Room!.Name,x.StartTime,x.EndTime,x.Status,x.CreatedAt);
+}
