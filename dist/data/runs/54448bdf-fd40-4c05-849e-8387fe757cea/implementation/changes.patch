+public static class DatabaseSeeder { public static async Task SeedAsync(IDbContextFactory<RoomBookingDbContext> f){await using var db=await f.CreateDbContextAsync();await db.Database.EnsureCreatedAsync();if(await db.Rooms.AnyAsync())return;var r=new[]{new Room{Name="Alfa",Capacity=4,IsActive=true},new Room{Name="Beta",Capacity=8,IsActive=true},new Room{Name="Gamma",Capacity=12,IsActive=false}};db.Rooms.AddRange(r);await db.SaveChangesAsync();db.Bookings.Add(new Booking{Title="Exempelmöte",BookedBy="System",RoomId=r[0].Id,StartTime=DateTimeOffset.UtcNow.AddDays(1),EndTime=DateTimeOffset.UtcNow.AddDays(1).AddHours(1),CreatedAt=DateTimeOffset.UtcNow});await db.SaveChangesAsync();} }
