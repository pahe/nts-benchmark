@inject BookingService Service
<EditForm Model="model" OnValidSubmit="Submit"><DataAnnotationsValidator/><ValidationSummary/><label for="title">Rubrik</label><InputText id="title" @bind-Value="model.Title"/><ValidationMessage For="@(()=>model.Title)"/><label for="bookedBy">Bokare</label><InputText id="bookedBy" @bind-Value="model.BookedBy"/><ValidationMessage For="@(()=>model.BookedBy)"/><label for="room">Rum</label><InputSelect id="room" @bind-Value="model.RoomId"><option value="0">Välj rum</option>@foreach(var r in rooms){<option value="@r.Id">@r.Name (@r.Capacity)</option>}</InputSelect><ValidationMessage For="@(()=>model.RoomId)"/><label for="start">Start</label><input id="start" type="datetime-local" @bind="startValue"/><label for="end">Slut</label><input id="end" type="datetime-local" @bind="endValue"/><p class="error" aria-live="polite">@error</p><button disabled="@saving" type="submit">@(saving?"Sparar…":"Spara")</button></EditForm>
@code { [Parameter] public int? Id {get;set;} [Inject] NavigationManager Nav {get;set;}=default!; BookingRequest model=new(); List<RoomResponse> rooms=[]; DateTime startValue=DateTime.Today.AddDays(1).AddHours(10),endValue=DateTime.Today.AddDays(1).AddHours(11); bool saving; string error=""; protected override async Task OnInitializedAsync(){rooms=await Service.GetRoomsAsync(true);if(Id is int id){var b=await Service.GetAsync(id);if(b is null){error="Bokningen hittades inte.";return;}if(b.Status==BookingStatus.Cancelled){error="En avbokad bokning kan inte redigeras.";return;}model=new(){Title=b.Title,BookedBy=b.BookedBy,RoomId=b.RoomId};startValue=b.StartTime.LocalDateTime;endValue=b.EndTime.LocalDateTime;}} async Task Submit(){saving=true;error="";model.StartTime=new DateTimeOffset(startValue,TimeZoneInfo.Local.GetUtcOffset(startValue));model.EndTime=new DateTimeOffset(endValue,TimeZoneInfo.Local.GetUtcOffset(endValue));var r=Id is int id?await Service.UpdateAsync(id,model):await Service.CreateAsync(model);saving=false;if(r.Value is null){error=r.Error??"Kunde inte spara.";return;}Nav.NavigateTo($"/bookings/{r.Value.Id}");} }
