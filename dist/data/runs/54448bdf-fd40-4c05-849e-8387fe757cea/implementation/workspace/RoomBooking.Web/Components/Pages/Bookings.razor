@page "/"
@page "/bookings"
@inject BookingService Service
<PageTitle>Bokningar</PageTitle><h1>Bokningar</h1><p><a class="button" href="/bookings/new">Skapa bokning</a></p><label for="room">Rum</label><select id="room" @bind="roomId" @bind:after="Load"><option value="">Alla rum</option>@foreach(var r in rooms){<option value="@r.Id">@r.Name</option>}</select><label for="date">Datum</label><input id="date" type="date" @bind="date" @bind:after="Load"/><p aria-live="polite">@message</p>@if(bookings is not null){if(bookings.Count==0){<p>Inga bokningar matchar filtret.</p>}else{<table><thead><tr><th>Rubrik</th><th>Rum</th><th>Bokare</th><th>Start</th><th>Slut</th><th>Status</th></tr></thead><tbody>@foreach(var b in bookings){<tr class="@(b.Status==BookingStatus.Cancelled?"cancelled":"")"><td><a href="/bookings/@b.Id">@b.Title</a></td><td>@b.RoomName</td><td>@b.BookedBy</td><td>@b.StartTime.ToLocalTime().ToString("g")</td><td>@b.EndTime.ToLocalTime().ToString("g")</td><td>@b.Status</td></tr>}</tbody></table>}}
@code { List<RoomResponse> rooms=[]; List<BookingResponse>? bookings; int? roomId; DateTime? date; string message="Laddar…"; protected override async Task OnInitializedAsync(){rooms=await Service.GetRoomsAsync();await Load();} async Task Load(){message="Laddar…";bookings=await Service.GetBookingsAsync(roomId,date is null?null:DateOnly.FromDateTime(date.Value));message="";} }
